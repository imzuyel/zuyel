# Google Gemini API Key (Required for AI quiz, summary, and chat features)
GEMINI_API_KEY=

# AI Model selection (e.g., gemini-2.5-flash, gemini-3.8-flash)
AI_MODEL=gemini-2.5-flash

# Database Connection (Optional: MySQL URL. Leave empty for resilient built-in mock/in-memory mode)
# Example: mysql://root:password@127.0.0.1:3306/ptsc_db
#
# Connection pooling (recommended for live quizzes / multiple Node instances):
#   connection_limit -> max sockets this PrismaClient opens (keep app_instances * limit < MySQL max_connections)
#   pool_timeout     -> seconds to wait for a free connection before failing (P2024)
#   connect_timeout  -> seconds to wait for a new TCP connection
# lib/prisma.ts appends these automatically when missing, and PRISMA_CONNECTION_LIMIT /
# PRISMA_POOL_TIMEOUT / PRISMA_CONNECT_TIMEOUT override the defaults.
# Example: mysql://root:password@127.0.0.1:3306/ptsc_db?connection_limit=10&pool_timeout=20&connect_timeout=10
DATABASE_URL=
PRISMA_CONNECTION_LIMIT=
PRISMA_POOL_TIMEOUT=
PRISMA_CONNECT_TIMEOUT=

# Application URL
APP_URL=http://localhost:3000

# Maximum PDF size in MB for uploads
MAX_PDF_SIZE_MB=25

# SMS Gateway Configuration (Optional)
SMS_API_KEY=
SMS_SENDER_ID=PTSC